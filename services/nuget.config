<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for every service under services/. Services get the LeiMa.Common* packages from
  GitHub Packages; everything else comes from nuget.org. The owner and token are read from
  environment variables so nothing account-specific or secret is committed:
    LEIMA_NUGET_OWNER  GitHub account that owns the repository
    LEIMA_NUGET_TOKEN  token with read:packages (CI: map secrets.GITHUB_TOKEN)
  See libs/dotnet/LeiMa.Common/CLAUDE.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="leima" value="https://nuget.pkg.github.com/%LEIMA_NUGET_OWNER%/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <leima>
      <add key="Username" value="%LEIMA_NUGET_OWNER%" />
      <add key="ClearTextPassword" value="%LEIMA_NUGET_TOKEN%" />
    </leima>
  </packageSourceCredentials>

  <!-- Only LeiMa.Common* may come from the LeiMa feed, and they never come from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="leima">
      <package pattern="LeiMa.Common*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
